# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=codebase_assistant

# JWT Security
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq LLM API
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: HuggingFace Hub Token (for higher rate limits on embedding model downloads)
HF_TOKEN=

# Real Email Delivery Service (SMTP)
# For Gmail: Use smtp.gmail.com, port 587, your email, and a 16-character Google App Password (not your normal account password).
# For SendGrid / Brevo / AWS SES: Use their respective SMTP host, port, username, and API key as password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="AI Codebase Assistant <your-email@gmail.com>"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
